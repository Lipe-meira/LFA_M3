<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<!-- Maquina de Turing: entrada binaria nao vazia, saida = entrada seguida de 0 (dobro em base 2). -->
<structure>
  <type>turing</type>
  <automaton>
    <!-- Estados -->
    <state id="0" name="q0">
      <x>140.0</x>
      <y>180.0</y>
      <initial/>
    </state>
    <state id="1" name="q1">
      <x>350.0</x>
      <y>180.0</y>
    </state>
    <state id="2" name="q2">
      <x>580.0</x>
      <y>180.0</y>
      <final/>
    </state>
    <!-- Primeiro digito obrigatorio: nao aceita entrada vazia -->
    <transition>
      <from>0</from><to>1</to>
      <read>0</read><write>0</write><move>R</move>
    </transition>
    <transition>
      <from>0</from><to>1</to>
      <read>1</read><write>1</write><move>R</move>
    </transition>
    <!-- Percorre o restante dos bits -->
    <transition>
      <from>1</from><to>1</to>
      <read>0</read><write>0</write><move>R</move>
    </transition>
    <transition>
      <from>1</from><to>1</to>
      <read>1</read><write>1</write><move>R</move>
    </transition>
    <!-- Ao encontrar branco, anexa 0 e aceita -->
    <transition>
      <from>1</from><to>2</to>
      <read/><write>0</write><move>R</move>
    </transition>
  </automaton>
</structure>
